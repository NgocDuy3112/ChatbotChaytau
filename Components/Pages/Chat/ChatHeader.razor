<div class="topbar">
    <div class="topbar-title">
        <h1>@(string.IsNullOrWhiteSpace(Title) ? "New chat" : Title)</h1>
        @if (!string.IsNullOrWhiteSpace(AttachedFile))
        {
            <span class="topbar-chip" title="@AttachedFile">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12" />
                </svg>
                @AttachedFile
            </span>
        }
    </div>

    <button class="btn-default" @onclick="@OnNewChat">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        New chat
    </button>
</div>

@code {
    [Parameter] public EventCallback OnNewChat { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? AttachedFile { get; set; }
}
