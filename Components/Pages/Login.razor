@page "/login"
@attribute [AllowAnonymous]
@inject IConfiguration Config

<PageTitle>Sign in</PageTitle>

<main class="login-shell">
    <div class="login-card">
        <div class="login-brand">
            <div class="login-mark" aria-hidden="true">C</div>
            <h1>Chatbot Chay Tau</h1>
            <p class="login-sub">Ask questions about your own documents.</p>
        </div>

        @if (GoogleConfigured)
        {
            <a class="btn-google" href="/account/external-login?provider=Google">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path fill="#4285F4" d="M23.5 12.3c0-.9-.1-1.5-.2-2.2H12v4.1h6.5c-.1 1.1-.8 2.7-2.2 3.8l3.4 2.6c2-1.9 3.8-4.7 3.8-8.3Z" />
                    <path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.4-2.6c-.9.6-2.1 1.1-3.6 1.1a7.9 7.9 0 0 1-7.4-5.4l-3.6 2.7C3.9 21.3 7.7 24 12 24Z" />
                    <path fill="#FBBC05" d="M4.6 14.2a8.4 8.4 0 0 1 0-4.4L1 7.1a12 12 0 0 0 0 10.8l3.6-2.7Z" />
                    <path fill="#EA4335" d="M12 4.7c2.3 0 3.9.9 4.8 1.7l3-3C18 1.6 15.2.4 12 .4 7.7.4 3.9 3.1 1 7.1l3.6 2.7A7.9 7.9 0 0 1 12 4.7Z" />
                </svg>
                Continue with Google
            </a>
        }
        else
        {
            <p class="login-note">
                Google sign-in isn't configured. Set
                <code>Authentication__Google__ClientId</code> and
                <code>Authentication__Google__ClientSecret</code> in <code>.env</code> to enable it.
            </p>
        }

        @if (Env.IsDevelopment())
        {
            <div class="login-divider"><span>or</span></div>
            <a class="btn-dev" href="/dev-login">Continue as dev user</a>
            <p class="login-hint">Local development only — never enabled in production.</p>
        }
    </div>
</main>

@code {
    [Inject] public IWebHostEnvironment Env { get; set; } = default!;

    private bool GoogleConfigured =>
        !string.IsNullOrWhiteSpace(Config["Authentication:Google:ClientId"])
        && !string.IsNullOrWhiteSpace(Config["Authentication:Google:ClientSecret"]);
}
