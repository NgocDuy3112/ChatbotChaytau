# Copy to `.env` and fill in. `.env` is gitignored; this template is tracked.
#
# Only secrets and deployment values live here. Non-secret settings
# (model ids, ChatModels, endpoints, logging) live in appsettings.json.

# --- Secrets ---
OpenRouter__ApiKey=
WebSearch__ApiKey=
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
POSTGRES_PASSWORD=
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=chatbot;Username=chatbot;Password=CHANGE_ME

# --- Deployment (used by docker-compose variable substitution) ---
ASPNETCORE_ENVIRONMENT=Development
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
